# Copy this file to .env.local and adjust as needed.

# Postgres connection string.
# Local (docker compose): the value below works as-is.
# Production (Neon): use the *pooled* connection string from the Neon console.
DATABASE_URL=postgres://leetlog:leetlog@localhost:5432/leetlog

# "local"  = single-user mode, no login required (good for self-hosting on your own machine)
# "github" = sign in with GitHub OAuth (needed when the app is reachable by others)
AUTH_MODE=local

# Required when AUTH_MODE=github. Generate a secret with: openssl rand -base64 32
# Create a GitHub OAuth App (GitHub → Settings → Developer settings → OAuth Apps) with
# callback URL <your app URL>/api/auth/callback/github, e.g. http://localhost:3000/api/auth/callback/github
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# Only when self-hosting AUTH_MODE=github somewhere other than Vercel:
# AUTH_TRUST_HOST=true
